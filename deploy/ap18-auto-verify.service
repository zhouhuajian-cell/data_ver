[Unit]
Description=AP18 auto verify scan (configured roots)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=algo
Group=algo
WorkingDirectory=/home/algo/pcap-analyse
Environment=AP18_MILEAGE_DB=/home/algo/ap18_data/mileage.db
ExecStart=/home/algo/miniconda3/envs/multi_traj/bin/python tools/auto_verify_scan.py --min-age-min 30 --limit 4
Nice=10
# 每轮可能分析多个数据集（含点云反投影），不限制启动超时
TimeoutStartSec=0
StandardOutput=append:/home/algo/pcap-analyse/logs/auto_verify.log
StandardError=append:/home/algo/pcap-analyse/logs/auto_verify.log
