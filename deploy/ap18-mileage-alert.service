[Unit]
Description=AP18 low effective-mileage ratio alert to Feishu
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=algo
Group=algo
WorkingDirectory=/home/algo/pcap-analyse
Environment=AP18_MILEAGE_DB=/home/algo/ap18_data/mileage.db
ExecStart=/home/algo/miniconda3/envs/multi_traj/bin/python tools/mileage_ratio_alert.py --threshold 90
Nice=10
StandardOutput=append:/home/algo/pcap-analyse/logs/mileage_alert.log
StandardError=append:/home/algo/pcap-analyse/logs/mileage_alert.log
